@page "/survey/branching/{SurveyId}"
@namespace JwtIdentity.Client.Pages.Survey
@inherits BranchingSurveyEditModel
@attribute [Authorize(Policy = Permissions.CreateSurvey)]
@using Syncfusion.Blazor.Diagram

<PageTitle>Survey Shark - Survey Branching</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h4">Survey Branching: @Survey?.Title</MudText>
    <DemoBorder CurrentDemoStep="@DemoStep" StepsToShow="@(new List<int>() { 0, 13 })" IsButton="true">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@NavigateBackToEdit">
            Back to Edit Survey
        </MudButton>
    </DemoBorder>
    <DemoPopup CurrentDemoStep="@DemoStep" StepsToShow="@(new List<int>() { 0 })" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
        <MudText Typo="Typo.h5" Class="mb-2">Welcome to Branching Configuration!</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">In this guided demo, you'll learn how to:</MudText>
        <MudList T="string" Dense="true" Class="ml-4">
            <MudListItem T="string">• Create question groups to organize your survey</MudListItem>
            <MudListItem T="string">• Move questions to different groups</MudListItem>
            <MudListItem T="string">• Configure conditional branching rules</MudListItem>
            <MudListItem T="string">• Visualize your survey flow</MudListItem>
        </MudList>
        <MudText Typo="Typo.body2" Class="mt-2">Let's get started!</MudText>
        <DemoBorder CurrentDemoStep="@DemoStep" StepsToShow="@(new List<int>() { 0 })" IsButton="true" Class="mt-3">
            <MudButton OnClick="NextDemoStep" Variant="Variant.Filled" Color="Color.Success">Next</MudButton>
        </DemoBorder>
    </DemoPopup>
    <DemoPopup CurrentDemoStep="@DemoStep" StepsToShow="@(new List<int>() { 13 })" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
        <MudText Typo="Typo.h6" Class="mb-2">Excellent work!</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">You've successfully configured branching for your survey. The flow diagram above shows how your survey will branch based on user responses.</MudText>
        <MudText Typo="Typo.body2">Click "Back to Edit Survey" to continue with the demo.</MudText>
        <DemoBorder CurrentDemoStep="@DemoStep" StepsToShow="@(new List<int>() { 13 })" IsButton="true" Class="mt-3">
            <MudButton OnClick="NextDemoStep" Variant="Variant.Filled" Color="Color.Success">Got it!</MudButton>
        </DemoBorder>
    </DemoPopup>
</MudStack>

@if (Survey == null || Loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudExpansionPanels MultiExpansion="true" Elevation="2">
        <MudExpansionPanel id="DiagramAccordion" Class="mb-3" Style="min-height:0;" Expanded="true">
            <TitleContent>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Visibility" Class="mr-3"></MudIcon>
                    <MudText Typo="Typo.h6">Survey Flow Diagram</MudText>
                </div>
            </TitleContent>
            <ChildContent>
                <MudAlert Severity="Severity.Info" Class="mb-4">
                    This diagram shows the flow of your survey based on the branching configuration. Blue boxes indicate conditional branching rules with arrows showing the flow path.
                </MudAlert>

                @if (Nodes.Any())
                {
                    <MudStack Spacing="2" Class="mb-3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                            <MudText Typo="Typo.body2" Style="min-width: 60px;">Zoom:</MudText>
                            <MudSlider Value="ZoomLevel"
                                       ValueChanged="@((double val) => OnZoomChanged(val))"
                                       Min="0.1"
                                       Max="2.0"
                                       Step="0.01"
                                       Color="Color.Primary"
                                       Style="max-width: 300px;" />
                            <MudText Typo="Typo.body2" Style="min-width: 60px;">@((ZoomLevel * 100).ToString("F0"))%</MudText>
                        </MudStack>
                    </MudStack>

                    <div style="width:100%; height:600px; overflow:auto; border:1px solid #ddd; position:relative;">
                        <div style="height:0px; width:100%;
                                      transform: scale(@ZoomLevel);
                                      transform-origin: left top;
                                      transition: transform 0.2s ease;">

                            <SfDiagramComponent @key="@DiagramRefreshKey"
                                                id="branchingDiagram"
                                                @ref="diagram"
                                                Created="DiagramCreated"
                                                Height="100%" Width="100%"
                                                Nodes="@Nodes"
                                                Connectors="@Connectors"
                                                NodeCreating="@OnNodeCreating"
                                                Constraints="@Constraints">
                                <SnapSettings Constraints="SnapConstraints.All & ~SnapConstraints.ShowLines" />
                                <Layout Type="@DiagramLayoutType"
                                        Orientation="LayoutOrientation.TopToBottom"
                                        HorizontalSpacing="40" VerticalSpacing="40"
                                        HorizontalAlignment="Syncfusion.Blazor.Diagram.HorizontalAlignment.Center"
                                        VerticalAlignment="VerticalAlignment.Top" />
                                <ScrollSettings ScrollLimit="ScrollLimitMode.Diagram" />
                                <PageSettings MultiplePage="true" BoundaryConstraints="BoundaryConstraints.Diagram" />
                            </SfDiagramComponent>
                        </div>
                    </div>
                }
                else
                {
                    <MudAlert Severity="Severity.Info">
                        No question groups defined yet. Add groups to create a branching flow.
                    </MudAlert>
                }
            </ChildContent>
        </MudExpansionPanel>
        <DemoPopup CurrentDemoStep="@DemoStep" StepsToShow="@(new List<int>() { 2, 4 })" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
            @if (DemoStep == 2)
            {
                <MudText Typo="Typo.body2" Class="mb-2">Excellent! You've created Group 1.</MudText>
                <MudText Typo="Typo.body2">Group 1 has been automatically named "Satisfied Customers" to organize questions for satisfied customers.</MudText>
            }
            else if (DemoStep == 4)
            {
                <MudText Typo="Typo.body2" Class="mb-2">Great! You've created Group 2.</MudText>
                <MudText Typo="Typo.body2">Group 2 has been automatically named "Unsatisfied Customers" to organize questions for unsatisfied customers.</MudText>
            }
            <DemoBorder CurrentDemoStep="@DemoStep" StepsToShow="@(new List<int>() { 2, 4 })" IsButton="true" Class="mt-3">
                <MudButton OnClick="NextDemoStep" Variant="Variant.Filled" Color="Color.Success">Next</MudButton>
            </DemoBorder>
        </DemoPopup>

        <MudExpansionPanel Class="mb-3" Expanded="@ShouldExpandPanel("Groups")">
            <TitleContent>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Folder" Class="mr-3"></MudIcon>
                    <MudText Typo="Typo.h6">Manage Question Groups</MudText>
                </div>
            </TitleContent>
            <ChildContent>
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Question Groups</MudText>
                    <DemoBorder CurrentDemoStep="@DemoStep" StepsToShow="@(new List<int>() { 1, 3 })" IsButton="true">
                        <MudButton id="AddGroupButton" Variant="Variant.Filled" Color="Color.Primary" OnClick="AddQuestionGroup" StartIcon="@Icons.Material.Filled.Add" Disabled="@IsAddGroupDisabled()">
                            Add Group
                        </MudButton>
                    </DemoBorder>
                    <DemoPopup CurrentDemoStep="@DemoStep" StepsToShow="@(new List<int>() { 1 })" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudText Typo="Typo.body2" Class="mb-2">First, let's create a new question group. Groups allow you to organize questions that will be shown together based on branching logic.</MudText>
                        <MudText Typo="Typo.body2">Click "Add Group" to create your first group.</MudText>
                    </DemoPopup>
                    <DemoPopup CurrentDemoStep="@DemoStep" StepsToShow="@(new List<int>() { 3 })" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudText Typo="Typo.body2">Great! Now create a second group. Click "Add Group" again.</MudText>
                    </DemoPopup>
                </MudStack>

                <MudExpansionPanels MultiExpansion="true">
                    @foreach (var group in QuestionGroups.OrderBy(g => g.GroupNumber))
                    {
                        var colorClass = $"group-color-{group.GroupNumber % 10}";
                        var panelId = $"Group{group.GroupNumber}Panel";
                        <MudExpansionPanel id="@panelId" Class="mb-3">
                            <TitleContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="width: 100%;">
                                    <span class="@($"group-badge group-badge-{group.GroupNumber % 10}")">Group @group.GroupNumber</span>
                                    <MudText Typo="Typo.h6" Style="flex: 1;">
                                        @(string.IsNullOrWhiteSpace(group.GroupName) ? "Unnamed Group" : group.GroupName)
                                    </MudText>
                                    @if (group.GroupNumber > 0)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="MudBlazor.Size.Small"
                                                       OnClick="@(() => DeleteQuestionGroup(group))" />
                                    }
                                </MudStack>
                            </TitleContent>
                            <ChildContent>
                                <MudPaper Elevation="2" Class="@($"pa-4 {colorClass}")">
                                    <MudStack Spacing="3">
                                        <div>
                                            @if (group.GroupNumber == 1)
                                            {
                                                <MudTextField id="Group1NameField" Label="Group Name" Value="@group.GroupName"
                                                              Variant="Variant.Outlined"
                                                              HelperText="Optional: Give this group a descriptive name"
                                                              ReadOnly="@IsGroupNameReadOnly(group.GroupNumber)"
                                                              ValueChanged="@(async (string value) => { group.GroupName = value; await UpdateQuestionGroup(group); await RefreshDiagram(); })" />
                                            }
                                            else if (group.GroupNumber == 2)
                                            {
                                                 <MudTextField id="Group2NameField" Label="Group Name" Value="@group.GroupName"
                                                               Variant="Variant.Outlined"
                                                               HelperText="Optional: Give this group a descriptive name"
                                                               ReadOnly="@IsGroupNameReadOnly(group.GroupNumber)"
                                                               ValueChanged="@(async (string value) => { group.GroupName = value; await UpdateQuestionGroup(group); await RefreshDiagram(); })" />
                                            }
                                            else
                                            {
                                                <MudTextField Label="Group Name" Value="@group.GroupName"
                                                              Variant="Variant.Outlined"
                                                              HelperText="Optional: Give this group a descriptive name"
                                                              ReadOnly="@IsGroupNameReadOnly(group.GroupNumber)"
                                                              ValueChanged="@(async (string value) => { group.GroupName = value; await UpdateQuestionGroup(group); await RefreshDiagram(); })" />
                                            }
                                        </div>

                                        <MudDivider />

                                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Questions in this Group:</MudText>

                                        @{
                                            var groupQuestions = Survey.Questions.Where(q => q.GroupId == group.GroupNumber).OrderBy(q => q.QuestionNumber).ToList();
                                        }

                                        @if (!groupQuestions.Any())
                                        {
                                            <MudAlert Severity="Severity.Info">No questions in this group yet. Assign questions from the Branching Rules section.</MudAlert>
                                        }
                                        else
                                        {
                                            <MudList T="string" Dense="true">
                                                @foreach (var question in groupQuestions)
                                                {
                                                    <MudListItem T="string">
                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                            <MudText>Q@(question.QuestionNumber): @question.Text</MudText>
                                                            @if (question.IsLastQuestion)
                                                            {
                                                                <MudChip Size="MudBlazor.Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Flag">Last</MudChip>
                                                            }
                                                        </MudStack>
                                                    </MudListItem>
                                                }
                                            </MudList>
                                        }
                                    </MudStack>
                                </MudPaper>
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            </ChildContent>
        </MudExpansionPanel>

        <MudExpansionPanel Class="mb-3" Expanded="@ShouldExpandPanel("Branching")">
            <TitleContent>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Class="mr-3"></MudIcon>
                    <MudText Typo="Typo.h6">Configure Branching Rules</MudText>
                </div>
            </TitleContent>
            <ChildContent>
                <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-bold">Assign Questions to Groups:</MudText>
                <DemoPopup CurrentDemoStep="@DemoStep" StepsToShow="@(new List<int>() { 5, 6 })" AnchorOrigin="AnchorOrigin" TransformOrigin="TransformOrigin">
                    <MudText Typo="Typo.body2" Class="mb-2">Now let's organize questions into groups. We'll move some questions to Group 1 and Group 2 based on survey logic.</MudText>
                    <MudText Typo="Typo.body2">Find Question 3 and move it to Group 1 using the dropdown selector.</MudText>
                    <DemoBorder CurrentDemoStep="@DemoStep" StepsToShow="@(new List<int>() { 5 })" IsButton="true" Class="mt-3">
                        <MudButton OnClick="NextDemoStep" Variant="Variant.Filled" Color="Color.Success">Skip</MudButton>
                    </DemoBorder>
                </DemoPopup>
                <DemoPopup CurrentDemoStep="@DemoStep" StepsToShow="@(new List<int>() { 7, 8 })" AnchorOrigin="AnchorOrigin" TransformOrigin="TransformOrigin">
                    <MudText Typo="Typo.body2" Class="mb-2">Great! Question 3 is now in Group 1.</MudText>
                    <MudText Typo="Typo.body2">Now find Question 4 and move it to Group 2.</MudText>
                    <DemoBorder CurrentDemoStep="@DemoStep" StepsToShow="@(new List<int>() { 7 })" IsButton="true" Class="mt-3">
                        <MudButton OnClick="NextDemoStep" Variant="Variant.Filled" Color="Color.Success">Skip</MudButton>
                    </DemoBorder>
                </DemoPopup>
                <MudPaper Class="pa-4 mb-4">
                    <MudList T="string" Dense="true">
                        @foreach (var question in Survey.Questions.OrderBy(q => q.QuestionNumber))
                        {
                            var questionColorClass = $"group-color-{question.GroupId % 10}";
                            var mcQuestions = Survey.Questions
                                .Where(q => q.QuestionType == QuestionType.MultipleChoice)
                                .OrderBy(q => q.QuestionNumber)
                                .ToList();
                            var isQ3 = mcQuestions.Count >= 3 && mcQuestions[2].Id == question.Id;
                            var isQ4 = mcQuestions.Count >= 4 && mcQuestions[3].Id == question.Id;
                            
                            <MudListItem T="string" Class="@questionColorClass">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <span class="@($"group-badge group-badge-{question.GroupId % 10}")">Group @question.GroupId</span>
                                    <MudText Style="flex: 1;">Q@(question.QuestionNumber): @question.Text</MudText>
                                    @if (question.IsLastQuestion)
                                    {
                                        <MudChip Size="MudBlazor.Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Flag">Last Question</MudChip>
                                    }
                                    else
                                    {
                                        <div>
                                            <DemoBorder CurrentDemoStep="@DemoStep" StepsToShow="@(isQ3 ? new List<int>() { 6 } : isQ4 ? new List<int>() { 8 } : new List<int>())">
                                                <MudSelect T="int" Label="Assign to Group" Value="question.GroupId"
                                                           ValueChanged="@(async value => { await MoveQuestionToGroup(question, value); await RefreshDiagram(); })"
                                                           Variant="Variant.Outlined" Dense="true" Style="width: 250px;"
                                                           Disabled="@IsQuestionGroupSelectorDisabled(question)">
                                                    @foreach (var g in QuestionGroups.OrderBy(x => x.GroupNumber))
                                                    {
                                                        <MudSelectItem Value="@g.GroupNumber">
                                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                                <span class="@($"group-badge group-badge-{g.GroupNumber % 10}")">Group @g.GroupNumber</span>
                                                                <span>@(string.IsNullOrWhiteSpace(g.GroupName) ? "" : $"- {g.GroupName}")</span>
                                                            </MudStack>
                                                        </MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </DemoBorder>
                                        </div>
                                    }
                                </MudStack>
                            </MudListItem>
                        }
                    </MudList>
                </MudPaper>

                <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-bold">Configure Conditional Branching:</MudText>
                <DemoPopup CurrentDemoStep="@DemoStep" StepsToShow="@(new List<int>() { 9, 10 })" AnchorOrigin="AnchorOrigin" TransformOrigin="TransformOrigin">
                    <MudText Typo="Typo.body2" Class="mb-2">Perfect! Now let's configure branching rules. This determines where users go based on their answers.</MudText>
                    <MudText Typo="Typo.body2">Find Question 1 (in Group 0) and set the first option to branch to Group 1.</MudText>
                    <DemoBorder CurrentDemoStep="@DemoStep" StepsToShow="@(new List<int>() { 9 })" IsButton="true" Class="mt-3">
                        <MudButton OnClick="NextDemoStep" Variant="Variant.Filled" Color="Color.Success">Skip</MudButton>
                    </DemoBorder>
                </DemoPopup>
                <DemoPopup CurrentDemoStep="@DemoStep" StepsToShow="@(new List<int>() { 11, 12 })" AnchorOrigin="AnchorOrigin" TransformOrigin="TransformOrigin">
                    <MudText Typo="Typo.body2" Class="mb-2">Excellent! Question 1 now branches to Group 1 for that option.</MudText>
                    <MudText Typo="Typo.body2">Now set Question 2's first option to branch to Group 2.</MudText>
                    <DemoBorder CurrentDemoStep="@DemoStep" StepsToShow="@(new List<int>() { 11 })" IsButton="true" Class="mt-3">
                        <MudButton OnClick="NextDemoStep" Variant="Variant.Filled" Color="Color.Success">Skip</MudButton>
                    </DemoBorder>
                </DemoPopup>
                <MudExpansionPanels MultiExpansion="true">
                    @foreach (var group in QuestionGroups.OrderBy(g => g.GroupNumber))
                    {
                        var groupQuestions = Survey.Questions.Where(q => q.GroupId == group.GroupNumber &&
                        !q.IsLastQuestion && // Exclude Last Questions from branching configuration
                        (q.QuestionType == QuestionType.MultipleChoice ||
                        q.QuestionType == QuestionType.SelectAllThatApply ||
                        q.QuestionType == QuestionType.TrueFalse)).OrderBy(q => q.QuestionNumber).ToList();

                        if (groupQuestions.Any())
                        {
                            var colorClass = $"group-color-{group.GroupNumber % 10}";
                            <MudExpansionPanel Class="mb-3">
                                <TitleContent>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <span class="@($"group-badge group-badge-{group.GroupNumber % 10}")">Group @group.GroupNumber</span>
                                        <MudText Typo="Typo.h6">@(string.IsNullOrWhiteSpace(group.GroupName) ? "Unnamed Group" : group.GroupName)</MudText>
                                    </MudStack>
                                </TitleContent>
                                <ChildContent>
                                    <MudPaper Elevation="2" Class="@($"pa-4 {colorClass}")">
                                        <MudStack Spacing="2">
                                            @foreach (var question in groupQuestions)
                                            {
                                                <MudDivider />
                                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                                                    Q@(question.QuestionNumber): @question.Text
                                                </MudText>

                                                @if (question.QuestionType == QuestionType.TrueFalse)
                                                {
                                                    <MudStack Spacing="2" Class="ml-4">
                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                            <MudText>If True, go to:</MudText>
                                                            <MudSelect T="int?" Label="Group" Value="@TrueBranch[question.Id]"
                                                                       ValueChanged="@(async (int? value) => { TrueBranch[question.Id] = value; await UpdateTrueFalseBranch((TrueFalseQuestionViewModel)question, value, true); await RefreshDiagram(); })"
                                                                       Variant="Variant.Outlined" Dense="true" Style="width: 250px;">
                                                                <MudSelectItem Value="@((int?)null)">Continue in sequence</MudSelectItem>
                                                                @foreach (var g in QuestionGroups.Where(qg => CanBranchToGroup(group.GroupNumber, qg.GroupNumber)).OrderBy(x => x.GroupNumber))
                                                                {
                                                                    <MudSelectItem Value="@((int?)g.GroupNumber)">
                                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                                            <span class="@($"group-badge group-badge-{g.GroupNumber % 10}")">Group @g.GroupNumber</span>
                                                                            <span>@(string.IsNullOrWhiteSpace(g.GroupName) ? "" : $"- {g.GroupName}")</span>
                                                                        </MudStack>
                                                                    </MudSelectItem>
                                                                }
                                                            </MudSelect>
                                                        </MudStack>
                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                            <MudText>If False, go to:</MudText>
                                                            <MudSelect T="int?" Label="Group" Value="@FalseBranch[question.Id]"
                                                                       ValueChanged="@(async (int? value) => { FalseBranch[question.Id] = value; await UpdateTrueFalseBranch((TrueFalseQuestionViewModel)question, value, false); await RefreshDiagram(); })"
                                                                       Variant="Variant.Outlined" Dense="true" Style="width: 250px;">
                                                                <MudSelectItem Value="@((int?)null)">Continue in sequence</MudSelectItem>
                                                                @foreach (var g in QuestionGroups.Where(qg => CanBranchToGroup(group.GroupNumber, qg.GroupNumber)).OrderBy(x => x.GroupNumber))
                                                                {
                                                                    <MudSelectItem Value="@((int?)g.GroupNumber)">
                                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                                            <span class="@($"group-badge group-badge-{g.GroupNumber % 10}")">Group @g.GroupNumber</span>
                                                                            <span>@(string.IsNullOrWhiteSpace(g.GroupName) ? "" : $"- {g.GroupName}")</span>
                                                                        </MudStack>
                                                                    </MudSelectItem>
                                                                }
                                                            </MudSelect>
                                                        </MudStack>
                                                    </MudStack>
                                                }
                                                else
                                                {
                                                    var options = question.QuestionType == QuestionType.MultipleChoice
                                                    ? ((MultipleChoiceQuestionViewModel)question).Options
                                                    : ((SelectAllThatApplyQuestionViewModel)question).Options;

                                                    @foreach (var option in options)
                                                    {
                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="ml-4 my-1">
                                                            <MudText Style="width: 200px;">@option.OptionText</MudText>
                                                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="MudBlazor.Size.Small" />
                                                            <DemoBorder CurrentDemoStep="@DemoStep" StepsToShow="@(IsBranchingSelectorDisabled(question, option) ? new List<int>() : new List<int>() { 10, 12 })">
                                                                <MudSelect T="int?" Label="Branch to Group" Value="@option.BranchToGroupId"
                                                                           Variant="Variant.Outlined" Dense="true" Style="width: 250px;"
                                                                           Disabled="@IsBranchingSelectorDisabled(question, option)"
                                                                           ValueChanged="@(async (int? value) => { option.BranchToGroupId = value; await UpdateChoiceOptionBranch(option); await RefreshDiagram(); })">
                                                                    <MudSelectItem Value="@((int?)null)">Continue in sequence</MudSelectItem>
                                                                    @foreach (var g in QuestionGroups.Where(qg => CanBranchToGroup(group.GroupNumber, qg.GroupNumber)).OrderBy(x => x.GroupNumber))
                                                                    {
                                                                        <MudSelectItem Value="@((int?)g.GroupNumber)">
                                                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                                                <span class="@($"group-badge group-badge-{g.GroupNumber % 10}")">Group @g.GroupNumber</span>
                                                                                <span>@(string.IsNullOrWhiteSpace(g.GroupName) ? "" : $"- {g.GroupName}")</span>
                                                                            </MudStack>
                                                                        </MudSelectItem>
                                                                    }
                                                                </MudSelect>
                                                            </DemoBorder>
                                                        </MudStack>
                                                    }
                                                }
                                            }
                                        </MudStack>
                                    </MudPaper>
                                </ChildContent>
                            </MudExpansionPanel>
                        }
                    }
                </MudExpansionPanels>

                @if (!Survey.Questions.Any(q => q.QuestionType == QuestionType.MultipleChoice ||
                            q.QuestionType == QuestionType.SelectAllThatApply ||
                            q.QuestionType == QuestionType.TrueFalse))
                {
                    <MudAlert Severity="Severity.Info">
                        No questions with branching capabilities found. Add Multiple Choice, Select All That Apply, or True/False questions to enable conditional branching.
                    </MudAlert>
                }
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>
}
